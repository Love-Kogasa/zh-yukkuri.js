{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "jest"],
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": true
  },
  "include": ["src", "tests"]
}
